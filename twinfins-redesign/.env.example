# The cart's public schedule feed — powers the "tide chart" calendar on
# /locations. See src/lib/calendar.ts for the one-time Google Calendar setup.
#
# Google Calendar → Settings for the cart's calendar →
#   "Access permissions": Make available to public
#   "Integrate calendar": copy the "Public address in iCal format"
#
# Unset: the section shows its "Calendar coming soon" state.
TWINFINS_CALENDAR_ICS=https://calendar.google.com/calendar/ical/YOUR_CALENDAR_ID/public/basic.ics
